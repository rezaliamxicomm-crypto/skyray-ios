    "delete.hint": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Removes your subscription and all its data from this phone"
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک و همه‌ی اطلاعات آن از این گوشی پاک می‌شود"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Удаляет подписку и все её данные с этого телефона"
          }
        }
      }
    },
    "delete.confirm": {
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your subscription, its servers and all account data are removed from this phone. Your link in Telegram keeps working, so you can add it again any time."
          }
        },
        "fa": {
          "stringUnit": {
            "state": "translated",
            "value": "اشتراک، سرورها و همه‌ی اطلاعات حساب از این گوشی پاک می‌شود. لینک شما در تلگرام همچنان کار می‌کند و هر وقت خواستید دوباره اضافه می‌شود."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Подписка, её серверы и все данные аккаунта будут удалены с этого телефона. Ваша ссылка в Telegram продолжит работать — добавить её можно в любой момент."
          }
        }
      }
    },
    "delete.do": {
      "extractionState": "manual",
